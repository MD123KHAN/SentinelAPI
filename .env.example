# AWS credentials are read through the standard AWS credential chain.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# A local Strands Decider server. This remains the default if no hosted endpoint is set.
STRANDS_DECIDER_URL=http://127.0.0.1:8099
STRANDS_DECIDER_MODEL=hobson-latest

# Hosted hackathon Decider. Paste the endpoint URL from the kit/platform; do not guess it.
# Keep the replacement key only in your local .env. Never commit .env or share the key in chat.
STRANDS_DECIDER_ENDPOINT=
STRANDS_DECIDER_API_KEY=
# Defaults to Authorization: Bearer <key>. Change only if the platform specifies another header.
STRANDS_DECIDER_API_KEY_HEADER=Authorization
STRANDS_DECIDER_API_KEY_PREFIX=Bearer
